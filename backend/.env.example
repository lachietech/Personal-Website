PORT=5000
NODE_ENV=development
# Render automatically uses its trusted ingress; locally the default is loopback.
# TRUST_PROXY=1
# Production uses secure SameSite=None cookies for the separate backend host.
# Set strict when frontend and API share a site (for example api.nielseninnovations.com).
# COOKIE_SAME_SITE=none
SECRET_KEY=replace-with-a-long-random-session-secret
CSRF_SECRET=replace-with-a-different-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret
MONGO_URI_CLIENT=mongodb://127.0.0.1:27017/nielsen-client-portal
MONGO_URI_UNIFORMS=mongodb://127.0.0.1:27017/nielsen-uniforms
MONGO_URI_MEANDERSUITE=mongodb://127.0.0.1:27017/nielsen-meander
RESEND_API_KEY=re_replace-with-your-key
API_KEY=replace-with-your-weather-api-key
PUBLIC_SITE_URL=https://nielseninnovations.com
TRUSTED_ORIGINS=https://nielseninnovations.com,https://www.nielseninnovations.com
CLIENT_PORTAL_BOOTSTRAP_ADMIN_USERNAME=
CLIENT_PORTAL_BOOTSTRAP_ADMIN_PASSWORD=
