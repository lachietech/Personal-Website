{
  "name": "nielsen-innovations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Independent Nielsen Innovations frontend and backend services",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "build:watch": "npm run build:watch --workspace frontend",
    "test": "node scripts/check-syntax.js && npm test --workspaces && npm run test:integration",
    "dev": "npm run build && node scripts/run-services.js --watch",
    "dev:client": "npm run build:watch --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:server": "npm run dev --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "start": "node scripts/run-services.js",
    "start:frontend": "npm start --workspace frontend",
    "start:backend": "npm start --workspace backend",
    "test:integration": "npm run build && node --test tests/*.test.js"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
